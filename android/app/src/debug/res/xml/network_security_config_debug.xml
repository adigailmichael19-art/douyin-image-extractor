<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security policy.
  - Trusts user-installed CAs so the local emulator can reach the real
    Douyin share page through the test environment's TLS gateway.
  - Cleartext HTTP is permitted only for the local emulator fixture server.
  This file is never merged into the release build.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
